          "    });\r",
          "\r",
          "} else if (pm.request.method === 'DELETE') {\r",
          "    pm.test(\"Successful DELETE request\", function () {\r",
          "        pm.expect(pm.response.code).to.be.oneOf([200, 204]);\r",
          "    });\r",
          "\r",
          "} else {\r",
          "    pm.test(\"Status code is 200\", function () {\r",
